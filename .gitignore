# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# macOS
.DS_Store

# Maven build output
target/

# Excel / Google Sheets exports
*.csv
*.xlsx
*.xls

# Vaadin (V2-F-01) — frontend build artifacts auto-generated by vaadin-maven-plugin.
# `src/main/frontend/index.html` IS committed (customizable entry point);
# everything under src/main/frontend/generated/ is auto-rebuilt and ignored.
node_modules/
src/main/dev-bundle/
src/main/bundles/
src/main/frontend/generated/
**/vite.generated.ts
**/vite.config.ts.timestamp-*
.vaadin/
# Vaadin writes these into the project root while it builds a dev bundle, and its
# TaskCleanFrontendFiles deletes them when the build ends. A run stopped mid-build leaves them, and
# Vaadin then treats them as the project's own and never removes them (#160). Commit
# package-lock.json instead once the project adds its own npm packages or CI builds the production
# bundle (#45), when pinned frontend versions start to matter.
/package.json
/package-lock.json
/tsconfig.json
/types.d.ts
/vite.config.ts
/.vaadin-node-tasks.lock

scripts/*
# The course requirement PDFs are the university's material and this repo is public, so
# they stay local; docs/requirements/requirements.md cites them by file name (#42).
docs/requirements/*.pdf

# Runtime log output (logs/event-ticket-system.log + rolled .gz archives)
logs/

# Local configuration files (e.g. for IDEs, build tools, etc.)
.idea/
.vscode/

# binaries
.classpath
.project
.factorypath

# settings
.settings/

# Local Supabase run script — holds the DB password, never commit
run-supabase.sh
.env
.env.*
!.env.example

# Agent worktrees (Claude Code), each a separate checkout
.claude/worktrees/
