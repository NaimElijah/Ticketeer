<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logger configuration for the Event Ticket System.
    SLR.8.1 (telemetry) + SLR.8.2 (real-time error logging) anchor here.
    Lecture 2 rule: NEVER log secrets, tokens, passwords, or PII.

    Application services use Lombok @Slf4j for SLF4J injection.
    Cross-cutting entry/exit tracing is handled by LoggingAspect (DEBUG level on the
    "com.ticketing.system.shared.logging" logger).
    Domain code may also use @Slf4j for WARN/ERROR; everything funnels to the same file.

    Every appender formats with LOG_PATTERN. The log is read one line per event, and a logged value
    can carry text a user typed, so a CR or LF in it would start a line the application never wrote.
    LOG_PATTERN replaces each run of CR/LF in the message with one space, here at the logging
    boundary rather than at each call site. An exception's message can carry such text too, and its
    stack trace spans several lines, so the exception (%ex) stays on the event's line: the inner
    %replace drops the trace's final line break, and the outer one puts " | " before a non-empty
    trace and in place of each run of CR/LF inside it. An event without an exception gets nothing.
    %nopex says the pattern prints the exception itself, so logback never appends a copy of its own.
    LogbackPatternTest holds every appender to it.
-->
<configuration>

    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %replace(%msg){'[\r\n]+', ' '}%replace(%replace(%ex){'[\r\n]+$', ''}){'^(?=.)|[\r\n]+', ' | '}%nopex%n"/>

    <!-- Console appender — primary output during dev and CI. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Rolling file appender — for production and dev runs. -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/event-ticket-system.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/event-ticket-system.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Every run that is not dev or a test: no profile (prod), supabase, or any profile added later.
         A catch-all rather than one block per profile, so a new profile can never boot with no
         appenders at all (36ac7924). The exclusions keep the profiles below on their own settings:
         blocks that both match merge, so root would get both blocks' appenders (a test run would gain
         FILE) and the later block's levels would win. AOP entry/exit tracing stays off. -->
    <springProfile name="!dev &amp; !test">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
        <logger name="com.ticketing.system" level="INFO"/>
        <logger name="com.ticketing.system.shared.logging" level="INFO"/>
    </springProfile>

    <!-- Dev profile: local run on JPA against in-memory H2, with the demo seed. Console + rolling file. -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
        <logger name="com.ticketing.system" level="DEBUG"/>
        <logger name="com.ticketing.system.shared.logging" level="DEBUG"/>
    </springProfile>

    <!-- Test profile: DEBUG for our code, console only. -->
    <springProfile name="test">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.ticketing.system" level="DEBUG"/>
        <logger name="com.ticketing.system.shared.logging" level="DEBUG"/>
    </springProfile>

</configuration>
