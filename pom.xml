<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.ticketing</groupId>
	<artifactId>event-ticket-system</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>event-ticket-system</name>
	<description>Event Ticket Management Platform</description>
	<url>https://github.com/NaimElijah/Ticketeer</url>
	<licenses>
		<license>
			<name>All Rights Reserved</name>
			<url>https://github.com/NaimElijah/Ticketeer/blob/main/LICENSE</url>
			<distribution>repo</distribution>
			<comments>Portions derived from event-ticket-system are under the MIT License; see LICENSE.</comments>
		</license>
	</licenses>
	<developers>
		<developer>
			<id>NaimElijah</id>
			<name>Naim Elijah</name>
			<url>https://github.com/NaimElijah</url>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/NaimElijah/Ticketeer.git</connection>
		<developerConnection>scm:git:https://github.com/NaimElijah/Ticketeer.git</developerConnection>
		<url>https://github.com/NaimElijah/Ticketeer</url>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- Same-line patches over what Boot 3.5.16 manages. The 3.5 line gets no OSS release after
		     2026-06-30, and its managed Tomcat 10.1.55, Jackson 2.21.4 and pgjdbc 42.7.11 carry
		     critical and high advisories that these patches fix (ADR-009). Drop each override when
		     the Boot it comes with manages that version or later. -->
		<tomcat.version>10.1.61</tomcat.version>
		<jackson-bom.version>2.21.8</jackson-bom.version>
		<postgresql.version>42.7.14</postgresql.version>
		<!-- Netty reaches only the dev classpath, through Vaadin Copilot, and the production profile
		     drops it with vaadin-dev; 4.1.135 still carries a critical and several high advisories. -->
		<netty.version>4.1.139.Final</netty.version>
		<jjwt.version>0.13.0</jjwt.version>
		<!-- Vaadin Flow (V2-F-01). 24.10.7 is the last free Vaadin 24 release: free maintenance ended
		     2026-06-16, and 24.10.8 and later need a Vaadin subscription even though Maven Central
		     serves them. Don't raise this inside 24.x; leave 24 only for 25, which needs Boot 4
		     (ADR-009). -->
		<vaadin.version>24.10.7</vaadin.version>
		<!-- Spring Modulith 1.4.x is the line compiled against Spring Boot 3.5 (per the official
		     compatibility matrix); it enforces the bounded-context module boundaries. -->
		<spring-modulith.version>1.4.14</spring-modulith.version>
		<!-- ArchUnit — hexagonal layering/naming rules run as JUnit tests. Keep it at the version
		     spring-modulith-core is built against (1.4.2 for Modulith 1.4.14): both declare it for the
		     test classpath, and the nearer pin here wins. -->
		<archunit.version>1.4.2</archunit.version>
	</properties>

	<!-- Vaadin BOM manages versions for the entire Vaadin Flow stack -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.vaadin</groupId>
				<artifactId>vaadin-bom</artifactId>
				<version>${vaadin.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- Spring Modulith BOM manages the versions of all spring-modulith-* artifacts. -->
			<dependency>
				<groupId>org.springframework.modulith</groupId>
				<artifactId>spring-modulith-bom</artifactId>
				<version>${spring-modulith.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- Testcontainers declares commons-compress 1.24.0 one level nearer than Vaadin's
			     flow-server declares 1.27.1, so Maven's nearest-wins rule put 1.24.0, with two OSV
			     advisories, on the runtime classpath although Testcontainers is test-only. Pin the
			     version flow-server, the runtime user, asks for. -->
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-compress</artifactId>
				<version>1.28.0</version>
			</dependency>
			<!-- Vaadin 24.10.7, the last free 24.x, ships jsoup 1.20.1 (flow-server) and Guava 33.4.0
			     (javaparser), both with high advisories (ADR-009). jsoup 1.23.2 is the version
			     Vaadin's own later 24.10 releases moved flow-server to; Guava 33.7.2 is the first fix.
			     With Hilla excluded (ADR-013), Guava reaches only Copilot's dev tree, which the
			     dependency audit still submits. Drop both with the move to Vaadin 25 (#199). -->
			<dependency>
				<groupId>org.jsoup</groupId>
				<artifactId>jsoup</artifactId>
				<version>1.23.2</version>
			</dependency>
			<dependency>
				<groupId>com.google.guava</groupId>
				<artifactId>guava</artifactId>
				<version>33.7.2-jre</version>
			</dependency>
			<!-- Only Boot's BOM reads the Tomcat, Jackson, pgjdbc and Netty properties above, and
			     Dependabot doesn't follow a property into a parent's BOM, so it would never propose
			     their next patches. Declared here at the same properties, they resolve exactly as
			     before and become visible to Dependabot. -->
			<dependency>
				<groupId>org.apache.tomcat.embed</groupId>
				<artifactId>tomcat-embed-core</artifactId>
				<version>${tomcat.version}</version>
			</dependency>
			<dependency>
				<groupId>com.fasterxml.jackson</groupId>
				<artifactId>jackson-bom</artifactId>
				<version>${jackson-bom.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.postgresql</groupId>
				<artifactId>postgresql</artifactId>
				<version>${postgresql.version}</version>
			</dependency>
			<dependency>
				<groupId>io.netty</groupId>
				<artifactId>netty-bom</artifactId>
				<version>${netty.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Health/metrics/telemetry endpoints (SLR.8.1, SLR.8.2) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- AOP — used by LoggingAspect to log entry/exit of every service method -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aop</artifactId>
		</dependency>

		<!-- BCrypt password hashing (IPasswordHasher impl) — lecture 2's recommended approach.
		     Pulls just the crypto module, NOT the full Spring Security stack. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<!-- JWT (JwtSessionManager): signs and verifies the session tokens. The three artifacts move
		     together through jjwt.version; justification in ADR-009. -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Flyway owns the schema: versioned SQL in db/migration, applied at startup, and Hibernate
		     only validates against it (ADR-007). Versions come from the Boot BOM. flyway-core carries
		     H2 support; PostgreSQL support has been a separate module since Flyway 10. runtime scope:
		     no main code imports Flyway, only Boot's auto-configuration and the ITs. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Vaadin Flow (V2-F-01) — version managed by vaadin-bom above.
		     Pulls in vaadin-core (the Apache-2.0 components only), vaadin-spring and, through
		     vaadin-dev, the dev server. Hilla is excluded: no view uses it, and its endpoint
		     controller, push servlet and code-generation jars would otherwise ship in the jar
		     (ADR-013). -->
		<dependency>
			<groupId>com.vaadin</groupId>
			<artifactId>vaadin-spring-boot-starter</artifactId>
			<exclusions>
				<exclusion>
					<groupId>com.vaadin</groupId>
					<artifactId>hilla</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Spring Modulith (bounded-context modules) — versions from the BOM above.
		     api: the @ApplicationModule annotations on each module's package-info, the only
		     Modulith type main code uses. The runtime starter would ship spring-modulith-core,
		     moments and ArchUnit in the jar for features this app doesn't use.
		     starter-test: ApplicationModules.verify() + Documenter (diagram/canvas generation).
		     The JPA event-publication registry (spring-modulith-starter-jpa) is deliberately
		     left out: notices are delivered after commit without an outbox (ADR-004). -->
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- ArchUnit — hexagonal layering + naming rules enforced as JUnit 5 tests. The core
		     library only: HexagonalRulesTest imports the classes and calls check() itself, so
		     archunit-junit5's @ArchTest engine has nothing to run. -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- Testcontainers: the *IT classes run against a throwaway PostgreSQL container, the
		     production dialect, instead of H2 (ADR-006). @ServiceConnection wires the container
		     into the Spring datasource. The version comes from the Boot BOM, 1.21.4 since Boot 3.5.16.
		     It must not drop below 1.21.4: Docker Engine 29 answers older clients with HTTP 400. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- H2: dev runs the JPA repositories on in-memory H2, and the @DataJpaTest
		     repository contract tests use it too. runtime (not test) scope so the
		     dev app can load org.h2.Driver; the deploy still uses Postgres. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Runs the *IT classes in the integration-test phase of `verify`; the goals and
			     classesDirectory come from spring-boot-starter-parent's pluginManagement. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
			</plugin>
			<!-- Vaadin Maven plugin (V2-F-01).
			     prepare-frontend runs every build to keep node_modules + dev-bundle in sync.
			     build-frontend only runs in the 'production' profile (see below). -->
			<plugin>
				<groupId>com.vaadin</groupId>
				<artifactId>vaadin-maven-plugin</artifactId>
				<version>${vaadin.version}</version>
				<executions>
					<execution>
						<id>frontend</id>
						<goals>
							<goal>prepare-frontend</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Production profile (V2-F-01).
		     Activate with -Pproduction. Bundles + minifies frontend assets at compile time.
		     Dev mode (default) hot-reloads the frontend from a dev server instead.
		     It also keeps the dev-only libraries out of the jar (#79; CI checks it):
		     - vaadin-dev (dev server, dev bundle, Copilot), excluded where vaadin-core brings it in,
		       as Vaadin's production-build docs do;
		     - H2, which only the dev profile and the tests run on. Without it, a datasource URL that
		       points at H2 fails the boot for want of a driver instead of running on an in-memory
		       database. -->
		<profile>
			<id>production</id>
			<dependencies>
				<dependency>
					<groupId>com.vaadin</groupId>
					<artifactId>vaadin-core</artifactId>
					<exclusions>
						<exclusion>
							<groupId>com.vaadin</groupId>
							<artifactId>vaadin-dev</artifactId>
						</exclusion>
					</exclusions>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<excludes combine.children="append">
								<exclude>
									<groupId>com.h2database</groupId>
									<artifactId>h2</artifactId>
								</exclude>
							</excludes>
						</configuration>
					</plugin>
					<plugin>
						<groupId>com.vaadin</groupId>
						<artifactId>vaadin-maven-plugin</artifactId>
						<version>${vaadin.version}</version>
						<executions>
							<execution>
								<id>frontend-prod</id>
								<goals>
									<goal>build-frontend</goal>
								</goals>
								<phase>compile</phase>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!-- Skip the Vaadin prepare-frontend goal, which test runs don't need. Activate with
		     -Pno-vaadin. It began as a workaround for a Windows NPE in prepare-frontend; that NPE no
		     longer reproduces on 24.7.0 or 24.10.7 (#40). Compile-only shortcut: frontend assets are
		     NOT prepared when this profile is active, so the app won't serve Vaadin views. Use for
		     test runs only. -->
		<profile>
			<id>no-vaadin</id>
			<build>
				<plugins>
					<plugin>
						<groupId>com.vaadin</groupId>
						<artifactId>vaadin-maven-plugin</artifactId>
						<version>${vaadin.version}</version>
						<executions>
							<execution>
								<id>frontend</id>
								<phase>none</phase>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
