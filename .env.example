# Environment variables a Ticketeer deployment sets. Keys only: never commit a value.
# Copy to .env (ignored by git) and fill in the ones you need. Optional keys are commented out:
# a key that is present but empty overrides its default with an empty value, so leave a key out
# rather than blank. Every other setting has a default in src/main/resources/application.yml
# (README, Configuration). The test suite needs none of these.

# Run profile: empty for plain PostgreSQL, supabase for Supabase over SSL, dev for local H2.
SPRING_PROFILES_ACTIVE=

# PostgreSQL. With no profile these default to localhost:5432/ticketing as postgres/postgres,
# credentials committed in this repository, so set them for any real deployment. The supabase
# profile has no default for DB_HOST, DB_USER or DB_PASSWORD.
DB_HOST=
# DB_PORT=
# DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT signing key, 256 bits or more. Required outside dev and test: the boot refuses the committed default.
JWT_SECRET=
# Username of the System Admin created at boot when none exists. Optional: admin.
# PLATFORM_ADMIN_USERNAME=
# Password of that System Admin. Required outside dev and test: the boot refuses the committed default.
PLATFORM_ADMIN_PASSWORD=

# WSEP payment and ticket-issuing service, an https:// URL. Optional: the course's WSEP host.
# WSEP_BASE_URL=
# Comma-separated usernames no member may register, besides PLATFORM_ADMIN_USERNAME. Optional: admin,platform.admin.
# IDENTITY_RESERVED_USERNAMES=
