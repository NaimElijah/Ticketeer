# Environment variables a Ticketeer deployment sets. Keys only: never commit a value.
# "Required outside dev" means a run without the dev profile needs it; the test suite needs none.
# Every other setting has a default in src/main/resources/application.yml (README, Configuration).

# Run profile: empty for plain PostgreSQL, supabase for Supabase over SSL, dev for local H2.
SPRING_PROFILES_ACTIVE=
# PostgreSQL host. Required outside dev (no default under supabase).
DB_HOST=
# PostgreSQL port. Optional: 5432.
DB_PORT=
# PostgreSQL database name. Optional: ticketing (postgres under supabase).
DB_NAME=
# PostgreSQL user. Required outside dev (no default under supabase).
DB_USER=
# PostgreSQL password. Required outside dev (no default under supabase).
DB_PASSWORD=
# JWT signing key, 256 bits or more. Required outside dev: the boot refuses the committed default.
JWT_SECRET=
# Username of the System Admin created at boot when none exists. Optional: admin.
PLATFORM_ADMIN_USERNAME=
# Password of that System Admin. Required outside dev: the boot refuses the committed default.
PLATFORM_ADMIN_PASSWORD=
# WSEP payment and ticket-issuing service, an https:// URL. Optional: the course's WSEP host.
WSEP_BASE_URL=
# Comma-separated usernames no member may register. Optional: admin,platform.admin.
IDENTITY_RESERVED_USERNAMES=
